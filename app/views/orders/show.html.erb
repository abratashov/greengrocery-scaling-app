<h1>Order #<%= @order.id %></h1>
<p>Status: <%= @order.state %></p>

<ul>
  <% @order.product_orders.each do |item| %>
    <li><%= item.product.name %> x <%= item.amount %> - <%= number_to_currency(item.total_price) %></li>
  <% end %>
</ul>

<% if @order.payment.present? %>
  <p>Payment: <%= @order.payment.state %> - <%= number_to_currency(@order.payment.total_price) %></p>
<% end %>

<%= link_to "Back", orders_path %>
