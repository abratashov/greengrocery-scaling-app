<h1>New Order</h1>

<%= form_with model: @order, url: orders_path do |form| %>
  <div>
    <label>Select products</label>
    <% @products.each do |product| %>
      <div>
        <%= check_box_tag "order[product_ids][]", product.id %>
        <%= label_tag "order[product_ids][]", "#{product.name} (#{number_to_currency(product.price)})" %>
        <%= number_field_tag "order[quantities][#{product.id}]", 1, min: 1, max: product.amount %>
      </div>
    <% end %>
  </div>

  <div>
    <%= form.submit "Create Order" %>
  </div>
<% end %>

<%= link_to "Back", orders_path %>
